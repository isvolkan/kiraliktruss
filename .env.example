# Bu dosyayı .env olarak kopyalayıp doldurun. Gerçek değerleri repoya koymayın.
DATABASE_URL=postgres://kullanici:sifre@sunucu:5432/veritabani
DATABASE_SSL=true
SESSION_SECRET=uzun-rastgele-bir-metin
ADMIN_EMAIL=admin@ornek.com
ADMIN_PASSWORD=guclu-bir-sifre
PORT=3000
# Ders projesi önizlemesi: true ise sayfa üstünde not + arama motorlarına kapalı
SITE_DEMO=true

# --- Sonradan eklenenler (hepsi isteğe bağlı) ---
# Sitenin tam adresi (sitemap, canonical, e-posta bağlantısı). Boşsa istekten türetilir.
SITE_URL=
# Neon sertifikası doğrulanırken sorun çıkarsa true yapın: sertifika doğrulanmaz (yalnız DATABASE_SSL=true iken).
# Adreste ?sslmode=require varsa pg onu bu ayardan önce uygular; bayrak çalışsın diye uygulama adresteki sslmode'u atar.
DATABASE_SSL_GEVSEK=
# Yerel testler için ayrı veritabanı (npm run test:db kurar). Boşsa testler DATABASE_URL'de çalışır.
TEST_DATABASE_URL=
# Yeni teklif e-postası: beşi de doluysa gönderilir, değilse yalnız konsola yazılır
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
BILDIRIM_EPOSTA=
