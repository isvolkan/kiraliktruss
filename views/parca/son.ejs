<%
  const altMenu = [
    ['Çalışmalar', '/calismalar'],
    ['Hakkımızda', '/hakkimizda'],
    ['İletişim', '/iletisim'],
  ];
  const devYazi = 'kiralık truss';
%>
</main>

<footer class="alt z-murekkep">
  <div class="ic">
    <%# Dev imza: her harf ayrı span (üstüne gelince beyaza döner); ekran okuyucu bütünü tek etiketle okur %>
    <p class="dev-imza" role="img" aria-label="Kiralık Truss"><% let hi = 0; for (const h of devYazi) { %><% if (h === ' ') { %> <% } else { %><span class="harf" aria-hidden="true" data-h="<%= h %>" style="--i:<%= hi++ %>"><%= h %></span><% } %><% } %></p>

    <div class="alt-sutunlar">
      <div>
        <p class="etiket">Adres</p>
        <p><%= firma.adres %><br><%= firma.ilce %></p>
      </div>
      <div>
        <p class="etiket">İletişim</p>
        <ul class="alt-liste">
          <li><a href="tel:<%= firma.telefonLink %>">Telefon: <%= firma.telefon %></a></li>
          <li>Faks: <%= firma.faks %></li>
          <li><a href="mailto:<%= firma.eposta %>"><%= firma.eposta %></a></li>
        </ul>
      </div>
      <div>
        <p class="etiket">Site</p>
        <ul class="alt-liste">
          <% for (const [ad, href] of altMenu) { %><li><a href="<%= href %>"><%= ad %></a></li><% } %>
          <li><a href="/teklif">Teklif iste</a></li>
          <li><a href="/kvkk">KVKK Aydınlatma Metni</a></li>
        </ul>
      </div>
    </div>
    <p class="telif">© <%= new Date().getFullYear() %> Kiralık Truss · <%= firma.kurulus %>'dan beri</p>
  </div>
</footer>

<%# Mobil hızlı eylem çubuğu: 768 px altında görünür; teklif sayfasında yalnızca Ara gösterilir %>
<% const teklifSayfasi = typeof yol !== 'undefined' && yol === '/teklif'; %>
<nav class="mobil-eylem" aria-label="Hızlı iletişim">
  <a class="mobil-eylem-ara" href="tel:<%= firma.telefonLink %>">
    <svg class="ok-svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 2.5h2.7l1.1 3-1.6 1.2a8.2 8.2 0 0 0 3.6 3.6l1.2-1.6 3 1.1v2.7a1.5 1.5 0 0 1-1.6 1.5A10.9 10.9 0 0 1 2 4.1 1.5 1.5 0 0 1 3.5 2.5Z"/></svg>
    <span>Ara</span>
  </a>
  <% if (!teklifSayfasi) { %>
  <a class="mobil-eylem-teklif" href="/teklif">
    <span>Teklif iste</span>
    <span class="ok" aria-hidden="true"><%- include('ok', { yon: 'sag' }) %></span>
  </a>
  <% } %>
</nav>

<%# Yukarı çık: sayfa bir ekrandan fazla kayınca sağ altta kayarak belirir (JS); JS yoksa hiç görünmez %>
<button class="yukari" type="button" aria-label="Sayfanın başına dön" tabindex="-1"><span aria-hidden="true"><%- include('ok', { yon: 'yukari' }) %></span></button>
</body>
</html>
