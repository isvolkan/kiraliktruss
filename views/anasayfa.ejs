<%- include('parca/bas', {
  aciklama: `Truss kiralıyoruz. Yaklaşık ${firma.stokMetretul} metretül orijinal alüminyum truss stoğu; ${firma.belgeler.join(', ')} belgeli. ${firma.kurulus}'dan beri fuar, stand, kongre ve konser kurulumları.`,
  ogGorsel: heroFotolar.length ? gorselUrl(heroFotolar[0]) : '/img/logo.png',
  yerelIsletme: true,
}) %>
<%
  // Bugünün tarihi (YYYY-AA-GG): tarih alanında geçmiş gün seçilmesin
  const b = new Date();
  const bugun = b.getFullYear() + '-' + String(b.getMonth() + 1).padStart(2, '0') + '-' + String(b.getDate()).padStart(2, '0');
  const donenler = ['Fuar için.', 'Stand için.', 'Kongre için.', 'Konser için.', 'Düğün için.', 'Tanıtım için.'];
%>

<%# a. Hero: mavi levha, dönen kelime, mini teklif formu %>
<section class="levha z-mavi hero">
  <%# Arka plan: en yeni kurulumdan geriye doğru fotoğraflar. İlki sayfayla gelir; diğerlerini JS sonradan yükler ve sırayla geçirir. %>
  <div class="hero-zemin" aria-hidden="true">
    <% heroFotolar.forEach((f, i) => { %><img <%- i === 0 ? 'class="aktif" src' : 'data-src' %>="<%= gorselUrl(f) %>" alt="" width="1200" height="800" data-kunye="<%= f.musteri %><%= f.sehir && f.sehir !== f.musteri ? ' · ' + f.sehir : '' %><%= f.yil ? ' · ' + f.yil : '' %>"<% if (i === 0) { %> fetchpriority="high"<% } %>><% }) %>
  </div>
  <div class="ic">
    <p class="etiket yukselen"><span>Beylikdüzü, İstanbul · <%= firma.kurulus %>'dan beri</span></p>
    <h1 class="hero-baslik">
      <span class="yukselen"><span>Truss kiralıyoruz.</span></span>
      <span class="donen" aria-hidden="true">
        <% donenler.forEach((k, i) => { %><span class="donen-k<%= i === 0 ? ' aktif' : '' %>"><%= k %></span><% }) %>
      </span>
      <span class="gizli donen-okuyucu">Fuar, stand, kongre, konser, düğün ve tanıtım için.</span>
      <span class="donen-sabit">Fuar, stand, kongre ve konser için.</span>
    </h1>
    <p class="hero-metin">Yaklaşık <%= firma.stokMetretul %> metretül orijinal alüminyum truss stoğumuz var. Hepsi TÜV, TSE ve CE belgeli.</p>

    <form class="mini-form beyaz-kart" method="get" action="/teklif">
      <p class="etiket">Üç soruyla teklife başlayın</p>
      <div class="mini-alanlar">
        <div class="alan">
          <label for="m-tur">Ne için?</label>
          <select id="m-tur" name="etkinlik_turu">
            <option value="">Seçin</option>
            <% for (const t of turler) { %><option><%= t %></option><% } %>
          </select>
        </div>
        <div class="alan">
          <label for="m-tarih">Ne zaman?</label>
          <input id="m-tarih" type="date" name="tarih" min="<%= bugun %>">
        </div>
        <div class="alan">
          <label for="m-sehir">Hangi şehirde?</label>
          <input id="m-sehir" name="sehir" autocomplete="address-level2">
        </div>
        <button class="btn btn-1" type="submit">Teklife devam et <span class="ok" aria-hidden="true"><%- include('parca/ok', { yon: 'sag' }) %></span></button>
      </div>
    </form>

    <p class="hero-ara">ya da hemen arayın: <a href="tel:<%= firma.telefonLink %>"><%= firma.telefon %> <span aria-hidden="true"><%- include('parca/ok', { yon: 'capraz' }) %></span></a></p>
    <% if (heroFotolar.length) { const f = heroFotolar[0]; %>
      <p class="hero-kunye" aria-hidden="true"><span class="hero-kunye-no">1 / <%= heroFotolar.length %></span> <span class="hero-kunye-isim"><%= f.musteri %><%= f.sehir && f.sehir !== f.musteri ? ' · ' + f.sehir : '' %><%= f.yil ? ' · ' + f.yil : '' %></span></p>
    <% } %>
  </div>
</section>

<%# b. Son kurulumlar: kendiliğinden akan sonsuz şerit (JS kartların kopyasını ekler). Açılışta dönen 6 iş burada yinelenmez.
     Şerit .ic dışında, ekranın iki kenarına kadar uzanır; JS yoksa elle yatay kaydırılan sıradan liste. %>
<section class="levha z-alu son-kurulum" aria-labelledby="son-baslik">
  <div class="ic">
    <div class="bolum-bas">
      <h2 id="son-baslik">Son kurulumlardan</h2>
      <a class="bag-ok" href="/calismalar">Tüm çalışmalar (<%= sayilar.proje %>) <span class="ok" aria-hidden="true"><%- include('parca/ok', { yon: 'sag' }) %></span></a>
    </div>
    <div class="serit-oklar">
      <button class="kare-dugme" type="button" data-serit="-1" aria-label="Önceki çalışma" aria-controls="serit"><span aria-hidden="true"><%- include('parca/ok', { yon: 'sol' }) %></span></button>
      <button class="kare-dugme" type="button" data-serit="1" aria-label="Sonraki çalışma" aria-controls="serit"><span aria-hidden="true"><%- include('parca/ok', { yon: 'sag' }) %></span></button>
    </div>
  </div>
  <div class="serit" id="serit" data-oto="38">
    <ul class="serit-ray">
      <%# Yalnız ilk 4 kart anında yüklenir, geri kalanı kaydırdıkça (lazy) %>
      <% seritProjeler.forEach((p, i) => { %><li><%- include('parca/kart', { p, hemen: i < 4, olcu: '(min-width: 488px) 380px, 78vw' }) %></li><% }) %>
    </ul>
  </div>
</section>

<%# c. Üç sayı: rakamlar görünüme girince basamak basamak döner (JS); DOM'da gerçek sayı yazılı %>
<section class="levha z-beyaz sayilar" aria-label="Sayılarla Kiralık Truss">
  <div class="ic">
    <ul class="uc-sayi">
      <li><span class="dev-rakam" data-rulo><%= firma.kurulus %></span><span class="sayi-etiket">yılından beri truss kiralıyoruz</span></li>
      <li><span class="dev-rakam" data-rulo>~<%= firma.stokMetretul %></span><span class="sayi-etiket">metretül alüminyum truss stoğu</span></li>
      <li><span class="dev-rakam" data-rulo><%= sayilar.proje %></span><span class="sayi-etiket">kayıtlı çalışma, <%= sayilar.fuar %> ayrı fuar</span></li>
    </ul>
  </div>
</section>

<%# d. Malzeme %>
<section class="levha z-murekkep malzeme" aria-labelledby="malzeme-baslik">
  <div class="ic">
    <h2 id="malzeme-baslik">Demir kaynatma değil. Orijinal alüminyum.</h2>
    <p class="giris">Truss sistemlerimizin hepsi Avrupa standartlarında imal edilmiştir. Depolama ve nakliye yüzünden deforme olmamış, ilk günkü alüminyum parlaklığındadır.</p>
    <ul class="belgeler">
      <% for (const belge of firma.belgeler) { %><li><span class="belge-isim"><%= belge %></span><span class="belge-et">belgeli</span></li><% } %>
    </ul>
  </div>
</section>

<%# e. Kurulum yaptığımız işlerden: sade ad ızgarası (en yeni 12 müşteri). Masaüstünde adın üstüne gelince fotoğraf önizlemesi. %>
<section class="levha z-beyaz kimler" aria-labelledby="kimler-baslik">
  <div class="ic">
    <div class="bolum-bas">
      <h2 id="kimler-baslik">Kurulum yaptığımız işlerden</h2>
      <a class="bag-ok" href="/calismalar">Tüm çalışmalar <span class="ok" aria-hidden="true"><%- include('parca/ok', { yon: 'sag' }) %></span></a>
    </div>
    <ul class="musteriler">
      <% for (const m of musteriler) { %><li><a href="/calismalar?q=<%= encodeURIComponent(m.ad) %>" data-onizleme="<%= gorselUrl(m, true) %>"><span class="m-isim"><%= m.ad %></span><% if (m.yil) { %><span class="m-yil"><%= m.yil %></span><% } %></a></li><% } %>
    </ul>
  </div>
</section>

<%- include('parca/cagri') %>
<%- include('parca/son') %>
