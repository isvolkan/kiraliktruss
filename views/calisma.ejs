<%
  const turAdlari = { fuar: 'Fuar', etkinlik: 'Etkinlik', kurumsal: 'Kurumsal' };
  // Künye satırları: boş olan çizilmez
  const kunye = [['Etkinlik', p.etkinlik !== p.sehir ? p.etkinlik : ''], ['Şehir', p.sehir], ['Yıl', p.yil], ['Tür', turAdlari[p.tur]]].filter(([, v]) => v);
  const projeOzeti = [p.musteri, p.etkinlik && p.etkinlik !== p.sehir ? p.etkinlik : '', p.sehir, p.yil].filter(Boolean).join(' · ');
  const projeAciklama = `${projeOzeti} alüminyum truss kurulumu. ${p.aciklama ? String(p.aciklama).slice(0, 110) : 'Kiralık Truss örnek çalışma ayrıntıları ve teklif talebi.'}`;
%>
<%- include('parca/bas', { aciklama: projeAciklama, ogGorsel: gorselUrl(p) }) %>

<section class="levha z-alu calisma">
  <div class="ic">
    <a class="bag-ok geri" href="/calismalar"><span class="ok" aria-hidden="true"><%- include('parca/ok', { yon: 'sol' }) %></span> Tüm çalışmalar</a>
    <h1><%= p.musteri %></h1>
    <div class="calisma-duzen">
      <div class="calisma-foto">
        <a class="foto-ac" href="<%= gorselUrl(p) %>" data-foto-ac>
          <img src="<%= gorselUrl(p) %>" alt="<%= p.musteri %> kurulumu" loading="eager" fetchpriority="high">
          <span class="gizli">Fotoğrafı tam boy aç</span>
        </a>
      </div>
      <dialog class="foto-kutu" aria-label="<%= p.musteri %> fotoğrafı, tam boy">
        <button class="foto-kapat" type="button" aria-label="Fotoğrafı kapat"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5 5 19"/></svg></button>
        <img alt="<%= p.musteri %> kurulumu, tam boy" data-src="<%= gorselUrl(p) %>">
      </dialog>
      <div class="calisma-yan">
        <% if (kunye.length) { %>
          <dl class="kunye">
            <% for (const [et, v] of kunye) { %><div><dt><%= et %></dt><dd><%= v %></dd></div><% } %>
          </dl>
        <% } %>
        <% if (p.aciklama) { %><p class="aciklama"><%= p.aciklama %></p><% } %>
        <div class="beyaz-kart benzer-kart">
          <h2 class="h3">Benzer bir kurulum mu gerekiyor?</h2>
          <a class="btn btn-1" href="/teklif?ref=<%= p.id %>">Bu işi örnek göstererek teklif iste <span class="ok" aria-hidden="true"><%- include('parca/ok', { yon: 'sag' }) %></span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (benzer.length) { %>
<section class="levha z-beyaz benzerler" aria-labelledby="benzer-baslik">
  <div class="ic">
    <h2 id="benzer-baslik">Benzer çalışmalar</h2>
    <ul class="izgara izgara-benzer">
      <% for (const b of benzer) { %><li><%- include('parca/kart', { p: b, olcu: '(min-width: 900px) 290px, 46vw' }) %></li><% } %>
    </ul>
  </div>
</section>
<% } %>

<%- include('parca/cagri') %>
<%- include('parca/son') %>
