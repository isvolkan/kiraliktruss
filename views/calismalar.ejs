<%
  // Filtre bağlantısı: mevcut parametreleri korur, "ek" ile değiştirir; sayfa yalnız açıkça verilirse eklenir
  const liste = filtre.gorunum === 'liste';
  const adres = (ek) => {
    const o = Object.assign({ tur: filtre.tur, sehir: filtre.sehir, yil: filtre.yil, q: filtre.q, gorunum: liste ? 'liste' : '' }, ek);
    const s = new URLSearchParams(Object.entries(o).filter(([, v]) => v !== '' && v != null)).toString();
    return '/calismalar' + (s ? '?' + s : '') + '#suzgec'; // sayfa en üste atmasın: filtre bölümünden devam
  };
  const suzgecli = filtre.tur || filtre.sehir || filtre.yil || filtre.q;
  const etkinSayi = [filtre.tur, filtre.sehir, filtre.yil, filtre.q].filter(Boolean).length;
  const turAdlari = { fuar: 'Fuar', etkinlik: 'Etkinlik', kurumsal: 'Kurumsal' };
  const turLevhalari = [['', 'Tümü', turSayilari.tumu], ['fuar', 'Fuar', turSayilari.fuar], ['etkinlik', 'Etkinlik', turSayilari.etkinlik], ['kurumsal', 'Kurumsal', turSayilari.kurumsal]];
  const seciliTur = ['fuar', 'etkinlik', 'kurumsal'].includes(filtre.tur) ? filtre.tur : '';
  const suzgecOzeti = [turAdlari[seciliTur], filtre.sehir, filtre.yil, filtre.q ? `"${filtre.q}" araması` : ''].filter(Boolean).join(', ');
  const sayfaAciklama = suzgecOzeti
    ? `${suzgecOzeti} — Kiralık Truss örnek çalışmaları (${toplam} sonuç). Fuar, etkinlik ve kurumsal alüminyum truss kurulumları.`
    : `Kiralık Truss örnek çalışmaları (${toplam} kayıtlı çalışma). Fuar, stand, kongre, konser ve kurumsal alüminyum truss kurulumları.`;
%>
<%- include('parca/bas', { aciklama: sayfaAciklama }) %>

<section class="levha z-alu calismalar">
  <div class="ic">
    <h1 class="sayfa-baslik" data-sayfa-baslik>Çalışmalar</h1>
    <p class="sonuc-sayisi"><%= toplam %> <%= suzgecli ? 'sonuç' : 'kayıtlı çalışma' %></p>

    <form class="suzgec" id="suzgec" method="get" action="/calismalar#suzgec" data-suzgec>
      <% if (seciliTur) { %><input type="hidden" name="tur" value="<%= seciliTur %>"><% } %>
      <% if (liste) { %><input type="hidden" name="gorunum" value="liste"><% } %>
      <%# Filtre paneli: kapalı açılır; etkin filtre varsa (filtreledikten sonra sayfa yenilenince) açık gelir. JS gerekmez.
          Filtre düğmesi Izgara | Liste seçicisiyle aynı satırda, kendi boyunda (CSS). %>
      <details class="suzgec-ac"<% if (suzgecli) { %> open<% } %>>
        <summary class="suzgec-dugme">
          <span>Filtre</span>
          <% if (etkinSayi) { %><span class="suzgec-sayi"><%= etkinSayi %> etkin</span><% } %>
          <svg class="suzgec-isaret" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 6l4.5 4.5L12.5 6"/></svg>
        </summary>
        <div class="suzgec-govde">
      <ul class="tur-levhalari" aria-label="Tür">
        <% for (const [deger, ad, n] of turLevhalari) { %>
          <li><a class="tur-levha" href="<%= adres({ tur: deger }) %>"<% if (seciliTur === deger) { %> aria-current="true"<% } %>><%= ad %> (<%= n %>)</a></li>
        <% } %>
      </ul>
      <div class="suzgec-alanlar">
        <div class="alan">
          <label for="s-sehir">Şehir</label>
          <select id="s-sehir" name="sehir">
            <option value="">Tüm şehirler</option>
            <% for (const s of sehirler) { %><option<% if (s === filtre.sehir) { %> selected<% } %>><%= s %></option><% } %>
          </select>
        </div>
        <div class="alan">
          <label for="s-yil">Yıl</label>
          <select id="s-yil" name="yil">
            <option value="">Tüm yıllar</option>
            <% for (const y of yillar) { %><option<% if (String(y) === filtre.yil) { %> selected<% } %>><%= y %></option><% } %>
          </select>
        </div>
        <div class="alan alan-ara">
          <label for="s-q">Ara</label>
          <input id="s-q" type="search" name="q" value="<%= filtre.q %>" placeholder="Müşteri ya da etkinlik adı">
        </div>
        <button class="btn btn-1" type="submit">Filtrele <span class="ok" aria-hidden="true"><%- include('parca/ok', { yon: 'sag' }) %></span></button>
      </div>
      <% if (suzgecli) { %><a class="bag-ok" href="/calismalar<%= liste ? '?gorunum=liste' : '' %>#suzgec">Filtreleri temizle <span class="ok" aria-hidden="true"><%- include('parca/ok', { yon: 'sol' }) %></span></a><% } %>
        </div>
      </details>
      <div class="suzgec-alt">
        <p class="gorunum">
          <a href="<%= adres({ gorunum: '' }) %>"<% if (!liste) { %> aria-current="true"<% } %>>Izgara</a>
          <span aria-hidden="true">|</span>
          <a href="<%= adres({ gorunum: 'liste' }) %>"<% if (liste) { %> aria-current="true"<% } %>>Liste</a>
        </p>
      </div>
    </form>

    <% if (!projeler.length) { %>
      <div class="bos-sonuc">
        <h2>Bu filtreyle çalışma bulunamadı.</h2>
        <a class="bag-ok" href="/calismalar#suzgec">Filtreleri temizle <span class="ok" aria-hidden="true"><%- include('parca/ok', { yon: 'sol' }) %></span></a>
      </div>
    <% } else if (liste) { %>
      <table class="liste-tablo">
        <caption class="gizli">Çalışmalar listesi</caption>
        <thead><tr><th scope="col">Müşteri</th><th scope="col">Etkinlik</th><th scope="col">Şehir</th><th scope="col">Yıl</th><th scope="col">Tür</th></tr></thead>
        <tbody>
          <% for (const p of projeler) { %>
            <tr>
              <td class="lt-musteri"><a href="/calismalar/<%= p.id %>"><%= p.musteri %></a></td>
              <td class="lt-ek"><%= p.etkinlik && p.etkinlik !== p.sehir ? p.etkinlik : '' %></td>
              <td class="lt-ek"><%= p.sehir || '' %></td>
              <td class="lt-ek"><%= p.yil || '' %></td>
              <td class="lt-tur"><%= turAdlari[p.tur] || '' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } else { %>
      <ul class="izgara">
        <% for (const p of projeler) { %><li><%- include('parca/kart', { p }) %></li><% } %>
      </ul>
    <% } %>

    <% if (sayfaSayisi > 1) { %>
      <nav class="sayfalama" aria-label="Sayfalar">
        <% if (sayfa > 1) { %><a href="<%= adres({ sayfa: sayfa - 1 }) %>"><span aria-hidden="true"><%- include('parca/ok', { yon: 'sol' }) %></span> Önceki</a><% } else { %><span class="pasif" aria-disabled="true"><span aria-hidden="true"><%- include('parca/ok', { yon: 'sol' }) %></span> Önceki</span><% } %>
        <span class="sayfa-no">Sayfa <%= sayfa %> / <%= sayfaSayisi %></span>
        <% if (sayfa < sayfaSayisi) { %><a href="<%= adres({ sayfa: sayfa + 1 }) %>">Sonraki <span aria-hidden="true"><%- include('parca/ok', { yon: 'sag' }) %></span></a><% } else { %><span class="pasif" aria-disabled="true">Sonraki <span aria-hidden="true"><%- include('parca/ok', { yon: 'sag' }) %></span></span><% } %>
      </nav>
    <% } %>
  </div>
</section>

<%- include('parca/cagri') %>
<%- include('parca/son') %>
