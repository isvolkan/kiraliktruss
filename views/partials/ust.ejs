<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= baslik %> · <%= firma.ad %></title>
  <meta name="description" content="<%= firma.kurulus %>'dan beri İstanbul'da fuar, konser, kongre ve etkinlikler için orijinal alüminyum truss kiralama ve teknik ekip desteği.">
  <meta name="theme-color" content="#0b111d">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;700;800&family=IBM+Plex+Mono:wght@400;500&family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <script src="/js/tema.js"></script>
</head>
<body class="<%= typeof govdeSinifi !== 'undefined' ? govdeSinifi : '' %>">
  <a class="atla" href="#icerik">İçeriğe geç</a>
  <div class="kolonlar" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>

  <header class="ust">
    <a class="logo" href="/" aria-label="<%= firma.ad %> ana sayfa">
      <svg viewBox="0 0 28 28" aria-hidden="true"><rect x="2" y="2" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M2 26 26 2M2 2l24 24" stroke="currentColor" stroke-width="1.2" opacity=".55"/></svg>
      <span>kiralık<b>truss</b></span>
    </a>
    <nav class="menu" id="menu" aria-label="Ana menü">
      <% const linkler = [['/', 'Ana sayfa'], ['/calismalar', 'Çalışmalar'], ['/hakkimizda', 'Hakkımızda'], ['/iletisim', 'İletişim']]; %>
      <% for (const [href, ad] of linkler) { %>
        <a href="<%= href %>" class="hap<%= (href === '/' ? yol === '/' : yol.startsWith(href)) ? ' aktif' : '' %>"><%= ad %></a>
      <% } %>
    </nav>
    <div class="ust-sag">
      <button class="hap tema-dugme" type="button" id="temaDugme" aria-label="Açık / koyu tema">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="currentColor"/><path d="M12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" stroke="currentColor" stroke-width="2"/></svg>
      </button>
      <a class="dugme" href="/teklif">Teklif iste</a>
      <button class="hap menu-dugme" type="button" id="menuDugme" aria-controls="menu" aria-expanded="false">Menü</button>
    </div>
  </header>

  <% if (bildirim) { %><div class="bildirim" role="status"><%= bildirim %></div><% } %>
  <main id="icerik">
