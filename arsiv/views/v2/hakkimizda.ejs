        <defs>
          <linearGradient id="g11duvar" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8d9195"/><stop offset="1" stop-color="#5f6367"/></linearGradient>
          <linearGradient id="g11zemin" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6b6259"/><stop offset="1" stop-color="#3b352f"/></linearGradient>
        </defs>
        <rect width="1200" height="800" fill="#4b4f53"/>
        <polygon points="0,0 1200,0 860,250 340,250" fill="#3e4245"/>
        <polygon points="0,0 340,250 340,560 0,800" fill="#575b5f"/>
        <polygon points="1200,0 860,250 860,560 1200,800" fill="#53575b"/>
        <rect x="340" y="250" width="520" height="310" fill="url(#g11duvar)"/>
        <polygon points="0,800 340,560 860,560 1200,800" fill="url(#g11zemin)"/>
        <rect x="520" y="330" width="160" height="230" fill="#2c2f31"/>
        <g fill="#2f2a25" opacity=".55"><ellipse cx="300" cy="700" rx="120" ry="18"/><ellipse cx="900" cy="690" rx="90" ry="14"/></g>
        <g stroke="#8a8f94" stroke-width="10"><line x1="420" y1="250" x2="420" y2="600"/><line x1="780" y1="250" x2="780" y2="600"/></g>
      </svg>
      <svg class="g11-kat g11-c" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <g class="oda">
          <line data-g="0" x1="340" y1="560" x2="0" y2="800"/><line data-g="0" x1="860" y1="560" x2="1200" y2="800"/>
          <line data-g=".05" x1="470" y1="560" x2="300" y2="800"/><line data-g=".05" x1="600" y1="560" x2="600" y2="800"/><line data-g=".05" x1="730" y1="560" x2="900" y2="800"/>
          <line data-g=".1" x1="260" y1="616" x2="940" y2="616"/><line data-g=".15" x1="150" y1="694" x2="1050" y2="694"/>
          <polyline data-g=".1" points="0,0 340,250 340,560 0,800"/>
          <polyline data-g=".1" points="1200,0 860,250 860,560 1200,800"/>
          <rect data-g=".2" x="340" y="250" width="520" height="310"/>
          <rect data-g=".3" x="520" y="330" width="160" height="230"/>
        </g>
        <g class="tr">
          <path data-g=".45" d="M430 560 V300 M462 560 V300 M430 560 L462 520 L430 480 L462 440 L430 400 L462 360 L430 320"/>
          <path data-g=".5" d="M738 560 V300 M770 560 V300 M738 560 L770 520 L738 480 L770 440 L738 400 L770 360 L738 320"/>
          <path data-g=".6" d="M430 300 H770 M430 268 H770 M430 300 L460 268 L490 300 L520 268 L550 300 L580 268 L610 300 L640 268 L670 300 L700 268 L730 300 L760 268"/>
          <path data-g=".8" d="M500 300 v18 M600 300 v18 M700 300 v18"/>
        </g>
      </svg>
      <svg class="g11-kat g11-b" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="g11isik" cx=".5" cy=".35" r=".6"><stop offset="0" stop-color="#3a2f63"/><stop offset="1" stop-color="#0d0d16"/></radialGradient>
          <linearGradient id="g11huzme" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffe9b0" stop-opacity=".55"/><stop offset="1" stop-color="#ffe9b0" stop-opacity="0"/></linearGradient>
        </defs>
        <rect width="1200" height="800" fill="url(#g11isik)"/>
        <polygon points="0,800 340,560 860,560 1200,800" fill="#141218"/>
        <rect x="480" y="320" width="240" height="140" fill="#2a7de1" opacity=".85"/>
        <rect x="480" y="320" width="240" height="140" fill="none" stroke="#9cc7ff" stroke-width="2"/>
        <g stroke="#c9ced3" stroke-width="5" fill="none">
          <path d="M430 560 V300 M462 560 V300 M738 560 V300 M770 560 V300 M430 300 H770 M430 268 H770"/>
          <path d="M430 560 L462 520 L430 480 L462 440 L430 400 L462 360 L430 320 M738 560 L770 520 L738 480 L770 440 L738 400 L770 360 L738 320" stroke-width="3"/>
          <path d="M430 300 L460 268 L490 300 L520 268 L550 300 L580 268 L610 300 L640 268 L670 300 L700 268 L730 300 L760 268" stroke-width="3"/>
        </g>
        <polygon points="490,318 510,318 620,560 380,560" fill="url(#g11huzme)"/>
        <polygon points="590,318 610,318 760,560 470,560" fill="url(#g11huzme)"/>
        <polygon points="690,318 710,318 860,560 600,560" fill="url(#g11huzme)"/>
        <rect x="360" y="540" width="480" height="24" fill="#26222c"/>
        <g fill="#08070b"><circle cx="250" cy="760" r="40"/><circle cx="380" cy="770" r="36"/><circle cx="820" cy="770" r="38"/><circle cx="960" cy="758" r="42"/><circle cx="600" cy="780" r="34"/></g>
      </svg>
      <figcaption class="g11-etiket mono" id="g11Etiket">03 / 03 · Kurulmuş sahne</figcaption>
    </figure>
  </div>
</section>

<%# 05 — Belgeler %>
<section class="bolum hk-belge" aria-labelledby="hk-belge-b">
  <div class="kap">
    <div class="bolum-bas">
      <div>
        <span class="bolum-no mono"><b>05</b> / 05</span>
        <h2 class="b-l" id="hk-belge-b" data-yuksel>Belgeli, orijinal alüminyum.</h2>
      </div>
      <p class="giris soluk">Truss sistemlerimiz Avrupa standartlarında imal edilmiştir.</p>
    </div>
    <ul class="hk-belgeler">
      <% for (const b of firma.belgeler) { %><li class="kose"><span class="mono">Belge</span><b><%= b %></b></li>
      <% } %>
    </ul>
    <div class="hk-eylem">
      <a class="dugme ana" href="<%= kok %>/teklif">Projeniz için teklif isteyin</a>
      <a class="dugme" href="<%= kok %>/calismalar">Çalışmalara bak →</a>
    </div>
  </div>
</section>

<%- include('partials/alt', { sayfaJs: ['hakkimizda'] }) %>
