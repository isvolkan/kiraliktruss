<%- include('partials/ust', { sayfaCss: ['anasayfa'] }) %>
<%
  const sayiYaz = (n) => Number(n).toLocaleString('tr-TR');
  const kapak = projeler[0];
  const yil = new Date().getFullYear();
  // Hizmet kartlarına, hero'dakinden farklı gerçek proje fotoğrafları seç (türe göre)
  const kullanilan = new Set(kapak ? [kapak.id] : []);
  const sec = (tur) => {
    const p = projeler.find(x => x.tur === tur && !kullanilan.has(x.id)) || projeler.find(x => !kullanilan.has(x.id)) || projeler[0];
    if (p) kullanilan.add(p.id);
    return p;
  };
  const hizmetler = [
    { ad: 'Fuar standı', metin: 'Stand iskeleti, tavan askıları ve grafik taşıyıcıları için orijinal alüminyum truss.', p: sec('fuar') },
    { ad: 'Konser ve sahne', metin: 'Sahne çatısı, ışık ve ses askıları için kule ve grid sistemleri.', p: sec('etkinlik') },
    { ad: 'Kongre ve kurumsal', metin: 'Lansman, toplantı ve tanıtım etkinliklerinde ekran, ışık ve sahne arkası taşıyıcıları.', p: sec('kurumsal') },
    { ad: 'Kurulum ve söküm ekibi', metin: 'Deneyimli teknik ekibimiz truss\'ı kurar, etkinlik bitince söker; alanı temiz teslim eder.', p: sec('fuar') },
  ];
  const adimlar = [
    ['Zemin ve platform', 'Kurulumun oturacağı düz zemin: podyum, kot ve ayak yerleri işaretlenir.'],
    ['Truss kuleler', 'Kare kesitli kuleler ayak plakası ve bağlantı pimleriyle dikilir.'],
    ['Tavan gridi', 'Kuleleri birleştiren kirişler tavan gridini oluşturur.'],
    ['Işık ve ses', 'Hareketli kafalar ve hoparlörler gride asılır.'],
    ['LED ekran', 'Arka duvardaki LED ekran modülleri truss taşıyıcıya kurulur.'],
  ];
  const gece = [
    { saat: '22:00', vakit: 'Gece · varış', olcu: '0,0 m', olcuAd: 'Grid yüksekliği', no: '', is: '', baslik: 'Ekip sahada', alt: 'Kapılar sabah açılır.' },
    { saat: '23:30', vakit: 'Gece · zemin', olcu: '0,4 m', olcuAd: 'Podyum kotu', no: '01', is: 'Podyum kuruldu', baslik: '', alt: '' },
    { saat: '01:15', vakit: 'Gece · kule', olcu: '6,0 m', olcuAd: 'Kule yüksekliği', no: '02', is: 'Kuleler dikildi', baslik: '', alt: '' },
    { saat: '02:40', vakit: 'Gece · grid', olcu: '8,5 m', olcuAd: 'Grid yüksekliği', no: '03', is: 'Grid kaldırıldı', baslik: '', alt: '' },
    { saat: '05:40', vakit: 'Sabah · ışık', olcu: '8,5 m', olcuAd: 'Grid yüksekliği', no: '', is: '', baslik: 'Işıklar asıldı', alt: 'Son kontroller.' },
    { saat: '09:00', vakit: 'Sabah · açılış', olcu: '12 m', olcuAd: 'Sahne genişliği', no: '', is: '', baslik: 'Kapılar açık', alt: 'Teslim edildi, etkinlik başlıyor.' },
  ];
%>

<%# 01 — Açılış %>
<section class="hero" aria-labelledby="hero-b">
  <div class="kap">
    <div class="hero-ust mono">
      <span><b>01</b> / 07</span>
      <span data-karistir><%= firma.ilce %></span>
      <span><%= firma.kurulus %>'dan beri</span>
    </div>
    <div class="hero-izgara">
      <div class="hero-metin">
        <h1 class="b-xl" id="hero-b" data-yuksel>Fuar, sahne ve etkinlikler için orijinal alüminyum truss.</h1>
        <div class="olcu hero-olcu" aria-hidden="true"><span>3000 mm</span></div>
        <p class="giris">Truss kiralama ve deneyimli teknik ekip desteği. Fiyatlandırma proje bazlıdır.</p>
        <div class="hero-dugmeler">
          <a class="dugme ana" href="<%= kok %>/teklif">Teklif iste</a>
          <a class="dugme" href="tel:<%= firma.telefonLink %>">Ara: <%= firma.telefon %></a>
        </div>
      </div>
      <% if (kapak) { %>
      <figure class="hero-foto">
        <div class="hero-foto-ic kose">
          <img src="/gorsel/<%= kapak.id %>" alt="<%= kapak.musteri %> için kurulan truss sistemi" fetchpriority="high" width="600" height="400">
          <span class="arti" style="left:-6px;top:38%"></span><span class="arti" style="right:-6px;top:62%"></span>
        </div>
        <figcaption class="kunye hero-kunye" aria-label="Fotoğraf bilgisi">
          <span class="kunye-hucre"><small>Proje</small><b><%= kapak.musteri %></b></span>
          <span class="kunye-hucre"><small>Yıl</small><b><%= kapak.yil || '—' %></b></span>
          <span class="kunye-hucre"><small>Etkinlik</small><b><%= kapak.etkinlik || '—' %></b></span>
          <span class="kunye-hucre"><small>Şehir</small><b><%= kapak.sehir || '—' %></b></span>
        </figcaption>
      </figure>
      <% } %>
    </div>
  </div>
</section>

<%# Sayı satırı %>
<section class="sayilar" aria-label="Rakamlarla">
  <div class="kap sayilar-ic">
    <div class="sayi"><span class="sayi-d" data-sayac="<%= firma.stokMetretul %>" data-on="~">~<%= sayiYaz(firma.stokMetretul) %></span><span class="sayi-b mono">mt</span><span class="sayi-e mono">truss stoğu</span></div>
    <div class="sayi"><span class="sayi-d" data-sayac="<%= firma.kurulus %>" data-grupsuz><%= firma.kurulus %></span><span class="sayi-e mono">yılından beri</span></div>
    <div class="sayi"><span class="sayi-d" data-sayac="<%= sayilar.proje %>"><%= sayiYaz(sayilar.proje) %></span><span class="sayi-b mono">proje</span><span class="sayi-e mono">arşivde</span></div>
    <div class="sayi"><span class="sayi-d" data-sayac="<%= sayilar.fuar %>"><%= sayiYaz(sayilar.fuar) %></span><span class="sayi-b mono">fuar</span><span class="sayi-e mono">farklı etkinlik</span></div>
  </div>
</section>

<%# 02 — Kurulan izometrik sahne (K-17) %>
<section class="k17" id="kurulum" aria-labelledby="k17-b">
  <div class="k17-sabit">
    <div class="k17-sol">
      <span class="bolum-no mono"><b>02</b> / 07</span>
      <h2 class="b-l" id="k17-b" data-yuksel>Bir sahne böyle kurulur.</h2>
      <ol class="k17-adimlar">
        <% adimlar.forEach(function (a, i) { %>
        <li><span class="mono">Adım <%= String(i + 1).padStart(2, '0') %> / <%= String(adimlar.length).padStart(2, '0') %></span><h3><%= a[0] %></h3><p><%= a[1] %></p></li>
        <% }) %>
      </ol>
    </div>
    <div class="k17-model" aria-hidden="true"></div>
  </div>
</section>

<%# 03 — Hizmet kartları (K-19) %>
<section class="bolum k19" aria-labelledby="k19-b">
  <div class="kap">
    <div class="bolum-bas">
      <div>
        <span class="bolum-no mono"><b>03</b> / 07</span>
        <h2 class="b-l" id="k19-b" data-yuksel>Ne için kiralıyoruz?</h2>
      </div>
      <p class="giris soluk">Her türlü fuar, etkinlik, kongre, konser ve tanıtım projesi.</p>
    </div>
    <div class="k19-yigin">
      <% hizmetler.forEach(function (h, i) { %>
      <article class="k19-kart kose">
        <div class="k19-metin">
          <span class="mono soluk"><%= String(i + 1).padStart(2, '0') %> / <%= String(hizmetler.length).padStart(2, '0') %></span>
          <h3 class="b-m"><%= h.ad %></h3>
          <p><%= h.metin %></p>
          <a class="ok-link" href="<%= kok %>/teklif">Teklif iste →</a>
        </div>
        <% if (h.p) { %><div class="k19-foto"><img src="/gorsel/<%= h.p.id %>" alt="<%= h.p.musteri %> — <%= h.p.etkinlik || h.ad %>" loading="lazy" width="600" height="400"></div><% } %>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<%# 04 — Kurulum gecesi (K-21) %>
<section class="k21" id="gece" aria-labelledby="k21-b">
  <div class="k21-sabit">
    <div class="k21-bas kap">
      <span class="bolum-no mono"><b>04</b> / 07</span>
      <h2 class="b-l" id="k21-b" data-yuksel>Bir kurulum gecesi.</h2>
      <p class="mono k21-not">Örnek akış · süreler projeye göre değişir</p>
    </div>
    <ol class="k21-liste kap">
      <% gece.forEach(function (s) { %>
      <li data-saat="<%= s.saat %>" data-vakit="<%= s.vakit %>" data-olcu="<%= s.olcu %>" data-olcuad="<%= s.olcuAd %>" data-no="<%= s.no %>" data-is="<%= s.is %>" data-baslik="<%= s.baslik %>" data-alt="<%= s.alt %>">
        <span class="mono"><%= s.saat %> · <%= s.vakit %></span>
        <strong><%= s.is || s.baslik %></strong>
        <span class="mono soluk"><%= s.olcuAd %>: <%= s.olcu %></span>
      </li>
      <% }) %>
    </ol>
  </div>
</section>

<%# Fuar adları bandı %>
<% if (fuarlar && fuarlar.length) { %>
<div class="bant" aria-label="Çalıştığımız fuarlardan bazıları">
  <div class="bant-ic">
    <% for (let i = 0; i < 2; i++) { %><ul class="bant-liste"<% if (i === 1) { %> aria-hidden="true"<% } %>><% for (const f of fuarlar) { %><li><%= f %></li><% } %></ul><% } %>
  </div>
</div>
<% } %>

<%# 05 — Öne çıkan projeler %>
<section class="bolum" aria-labelledby="proje-b">
  <div class="kap">
    <div class="bolum-bas">
      <div>
        <span class="bolum-no mono"><b>05</b> / 07</span>
        <h2 class="b-l" id="proje-b" data-yuksel>Son kurduklarımızdan</h2>
      </div>
      <a class="ok-link" href="<%= kok %>/calismalar">Bütün çalışmalar (<%= sayilar.proje %>) →</a>
    </div>
    <div class="izgara-kart">
      <% for (const p of projeler) { %><%- include('partials/kart', { p }) %><% } %>
    </div>
  </div>
</section>

<%# 06 — Metretül hesaplayıcı %>
<section class="bolum hesap-bolum" id="hesapla" aria-labelledby="hesap-b">
  <div class="kap iki">
    <div>
      <span class="bolum-no mono"><b>06</b> / 07</span>
      <h2 class="b-l" id="hesap-b" data-yuksel>Ne kadar truss lazım?</h2>
      <p class="giris soluk">Stand ölçünüzü girin, yaklaşık metretülü hesaplayalım. Sonuç teklif formuna otomatik geçer. Kesin ölçü keşif ve çizimden sonra çıkar.</p>
    </div>
    <form class="hesap kose" id="hesap" action="<%= kok %>/teklif" method="get">
      <label class="alan">Yapı
        <select name="yapi" id="hYapi">
          <option value="cerceve">Çerçeve (4 ayak + üst kuşak)</option>
          <option value="tavan">Çerçeve + tavan ara kirişleri</option>
          <option value="kemer">Kemer / kapı (2 ayak + kiriş)</option>
          <option value="kule">Kule (tek dikey)</option>
        </select>
      </label>
      <div class="hesap-satir">
        <label class="alan">En (m)<input type="number" id="hEn" min="1" max="60" step="0.5" value="6" inputmode="decimal"></label>
        <label class="alan">Boy (m)<input type="number" id="hBoy" min="1" max="60" step="0.5" value="4" inputmode="decimal"></label>
        <label class="alan">Yükseklik (m)<input type="number" id="hYuk" min="1" max="12" step="0.5" value="3" inputmode="decimal"></label>
        <label class="alan">Adet<input type="number" id="hAdet" min="1" max="50" step="1" value="1" inputmode="numeric"></label>
      </div>
      <output class="hesap-sonuc" id="hSonuc" aria-live="polite"><b>0</b> <span class="mono">metretül</span></output>
      <input type="hidden" name="metretul" id="hMetretul">
      <button class="dugme ana" type="submit">Bu ölçüyle teklif iste</button>
    </form>
  </div>
</section>

<%# 07 — "2009'dan beri" (M-15) %>
<section class="bolum hakkinda" aria-labelledby="hak-b">
  <div class="kap">
    <span class="bolum-no mono"><b>07</b> / 07</span>
    <h2 class="sr-only" id="hak-b">Hakkımızda</h2>
    <p class="hak-yazi" id="hakYazi"><%= firma.kurulus %>'dan beri İstanbul'da fuar, sahne ve etkinlikler için truss kiralıyoruz. Stoğumuzdaki yaklaşık <%= sayiYaz(firma.stokMetretul) %> metretül sistem kesinlikle demir kaynatma değil, Avrupa standartlarında imal edilmiş orijinal alüminyumdur; <%= firma.belgeler.join(', ') %> belgelidir. Kurulumu deneyimli teknik ekibimiz yapar, fiyatı proje bazlı veririz.</p>
    <a class="dugme" href="<%= kok %>/hakkimizda">Hakkımızda →</a>
  </div>
</section>

<%- include('partials/alt', { sayfaJs: ['anasayfa'] }) %>
