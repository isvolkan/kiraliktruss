<%#
  Sayfa başı: <head>, üst künye şeridi, ana menü. Her görünüm en başta bunu çağırır.
  İsteğe bağlı yereller: aciklama (meta description), sinif (body sınıfı)
%><!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= baslik %> · <%= firma.ad %></title>
  <meta name="description" content="<%= typeof aciklama !== 'undefined' ? aciklama : `${firma.ad}: ${firma.kurulus}'dan beri fuar standı, sahne ve etkinlikler için alüminyum truss kiralama. ${firma.ilce}.` %>">
  <% if (demo) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <meta name="theme-color" content="#16181D">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/v4/css/v4.css">
  <%# Önce içerik: bu küçük betik yalnız <html>'e "js" sınıfı ekler; JS kapalıysa hiçbir şey gizlenmez %>
  <script src="/v4/js/erken.js"></script>
  <script src="/v4/js/v4.js" defer></script>
</head>
<body class="<%= typeof sinif !== 'undefined' ? sinif : '' %>">
<a class="atla" href="#icerik">İçeriğe geç</a>

<% if (demo) { %>
<p class="demo-notu">Önizleme sürümü: bu site bir ders projesidir, gönderilen talepler gerçek teklife dönüşmeyebilir.</p>
<% } %>

<div class="kunye-serit">
  <div class="kap kunye-serit__ic">
    <span class="mono"><%= firma.ilce %> · <%= firma.kurulus %>'dan beri</span>
    <span class="mono kunye-serit__belge"><%= firma.belgeler.join(' · ') %> belgeli malzeme</span>
    <a class="mono" href="tel:<%= firma.telefonLink %>"><%= firma.telefon %></a>
  </div>
</div>

<header class="ust" id="ust">
  <div class="kap ust__ic">
    <a class="logo" href="<%= kok %>/" aria-label="<%= firma.ad %> ana sayfa">
      <svg class="logo__isaret" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <rect x="3" y="11" width="34" height="18" fill="none" stroke="currentColor" stroke-width="3"/>
        <path d="M3 29 L14.3 11 L25.6 29 L37 11" fill="none" stroke="currentColor" stroke-width="2.4"/>
      </svg>
      <span class="logo__ad">Kiralık<b>Truss</b></span>
    </a>

    <%
      const menu = [
        ['/calismalar', 'Çalışmalar'],
        ['/hakkimizda', 'Hakkımızda'],
        ['/iletisim', 'İletişim'],
      ];
    %>
    <button class="menu-dugme" type="button" aria-expanded="false" aria-controls="ana-menu">
      <span class="menu-dugme__cizgi" aria-hidden="true"></span>
      <span class="menu-dugme__yazi">Menü</span>
    </button>
    <nav class="menu" id="ana-menu" aria-label="Ana menü">
      <ul>
        <% for (const [adres, ad] of menu) { const etkin = yol === adres || yol.startsWith(adres + '/'); %>
          <li><a href="<%= kok %><%= adres %>"<% if (etkin) { %> aria-current="page"<% } %>><%= ad %></a></li>
        <% } %>
        <% if (yonetici) { %><li><a href="/yonetim">Yönetim</a></li><% } %>
      </ul>
      <div class="menu__eylem">
        <a class="dugme dugme--cizgi" href="tel:<%= firma.telefonLink %>">
          <svg class="ikon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
          <span>Ara</span>
        </a>
        <a class="dugme dugme--sinyal" href="<%= kok %>/teklif"<% if (yol === '/teklif') { %> aria-current="page"<% } %>>Teklif iste</a>
      </div>
    </nav>
  </div>
</header>

<% if (bildirim) { %>
<div class="kap"><p class="bildirim" role="status"><%= typeof bildirim === 'string' ? bildirim : (bildirim.mesaj || '') %></p></div>
<% } %>

<main id="icerik" tabindex="-1">
