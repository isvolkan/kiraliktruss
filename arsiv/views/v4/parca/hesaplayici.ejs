<%#
  Metretül hesaplayıcı. JS açıkken ölçüleri girince sonuç ve çizim anında değişir (public/v4/js/v4.js → hesaplayici).
  JS kapalıyken de çalışır: form GET ile teklif sayfasına gider, kullanıcı metretülü kendisi yazar.
  Formüller veri/duzeltmeler.md'de; sonuç her zaman "tahmini".
%>
<form class="hesap" action="<%= kok %>/teklif" method="get" data-hesap>
  <fieldset class="hesap__sekil">
    <legend>Yapı biçimi</legend>
    <% const sekiller = [
         ['cerceve', 'Çerçeve', 'Stand iskeleti: 4 dikme + üst kuşak'],
         ['tavan', 'Çerçeve + tavan', 'Her 3 m\'de bir ara kiriş'],
         ['kemer', 'Kemer / kapı', '2 dikme + üst kiriş'],
         ['kule', 'Kule', 'Tek dikme'],
       ];
       sekiller.forEach(([deger, ad, not], i) => { %>
      <label class="secim">
        <input type="radio" name="sekil" value="<%= deger %>"<% if (i === 0) { %> checked<% } %>>
        <span class="secim__kutu"><b><%= ad %></b><small><%= not %></small></span>
      </label>
    <% }) %>
  </fieldset>

  <div class="hesap__olcu">
    <label class="alan" data-olcu="en">
      <span class="alan__ad">En <small>(m)</small></span>
      <input type="number" name="en" inputmode="decimal" min="0.5" max="100" step="0.5" value="6">
    </label>
    <label class="alan" data-olcu="boy">
      <span class="alan__ad">Derinlik <small>(m)</small></span>
      <input type="number" name="boy" inputmode="decimal" min="0.5" max="100" step="0.5" value="3">
    </label>
    <label class="alan" data-olcu="yukseklik">
      <span class="alan__ad">Yükseklik <small>(m)</small></span>
      <input type="number" name="yukseklik" inputmode="decimal" min="0.5" max="30" step="0.5" value="3">
    </label>
    <label class="alan" data-olcu="adet">
      <span class="alan__ad">Adet</span>
      <input type="number" name="adet" inputmode="numeric" min="1" max="50" step="1" value="1">
    </label>
  </div>

  <div class="hesap__cizim" aria-hidden="true">
    <svg viewBox="0 0 320 220" data-hesap-cizim></svg>
  </div>

  <div class="hesap__sonuc">
    <p class="hesap__etiket mono">Tahmini toplam</p>
    <p class="hesap__deger" aria-live="polite"><output data-hesap-sonuc>—</output> <span>metretül</span></p>
    <p class="hesap__formul mono" data-hesap-formul>Ölçüleri girin; hesap anında güncellenir.</p>
    <label class="alan alan--js-yok">
      <span class="alan__ad">Metretül (biliyorsanız)</span>
      <input type="number" name="metretul" min="1" max="5000" inputmode="numeric" data-hesap-metretul>
    </label>
    <button class="dugme dugme--sinyal dugme--genis" type="submit">Bu ölçüyle teklif iste</button>
    <p class="hesap__not">Tahminidir; kesin ölçü keşiften sonra belirlenir. Toplam stok yaklaşık <%= firma.stokMetretul %> metretül.</p>
  </div>
</form>
